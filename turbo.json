{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_WASM_CEILING_BYTES"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Turbo hides undeclared environment variables from tasks. Without
      // these the FFmpeg integration suites silently skip themselves, and a
      // green run stops meaning anything.
      "passThroughEnv": ["FFMPEG_PATH", "FFPROBE_PATH"]
    },
    "copy:audit": {
      "cache": false
    }
  }
}
