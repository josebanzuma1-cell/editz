{
  "name": "@editz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./dev": "./src/dev.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "bundle-migrations": "node scripts/bundle-migrations.mjs",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@editz/config": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
