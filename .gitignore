# The ffmpeg.wasm core is ~31MB and comes from @ffmpeg/core-mt. It is copied
# into place by apps/web/scripts/copy-ffmpeg-core.mjs on predev/prebuild —
# committing it would put a 31MB binary in every clone.
apps/web/public/ffmpeg/
next.config.compiled.js
*.tsbuildinfo
.editz-dev/

# Regenerated by Next on every run, and its contents differ between
# `next dev` and `next build`, so tracking it means churn in every diff.
# Next generates it on demand; create-next-app ignores it too.
apps/web/next-env.d.ts
