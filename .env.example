# Public site origin, used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ceiling above which a job is sent to the server instead of running in the
# browser. Bytes. Default 250MB. Lower it to test the server path locally.
NEXT_PUBLIC_WASM_CEILING_BYTES=262144000

# --- Nothing below here is used in M1. Listed so the shape is known. ---

# M3 — storage and queue
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# DATABASE_URL=
# REDIS_URL=

# M4 — auth and billing
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
